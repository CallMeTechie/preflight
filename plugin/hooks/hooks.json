{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/hooks/detect-spec-plan-write.sh",
						"timeout": 10,
						"description": "Nudge preflight review when a spec/plan doc is written"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/hooks/clear-orphaned-lock.sh",
						"timeout": 10,
						"description": "Clear an orphaned preflight review lock left by an interrupted run"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-plugin-update.sh",
						"timeout": 10,
						"description": "Notify (stderr only) when a newer preflight version is available, at most once a day"
					}
				]
			}
		]
	}
}
